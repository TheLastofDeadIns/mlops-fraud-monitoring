# PostgreSQL
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=fraud_pass
POSTGRES_DB=fraud_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SCORING_TOPIC=scoring

# CSV с размеченными транзакциями. Файл монтируется в data_loader, transaction_simulator и fraud_attack.
# Linux / macOS: TRAIN_DATA_CSV="/home/me/data/train.csv"
# Windows (Docker Desktop): TRAIN_DATA_CSV="C:/Users/me/data/train.csv"
TRAIN_DATA_CSV="/path/to/train.csv"
