    {
      "type": "table",
      "id": 9,
      "title": "Мерчанты с наибольшим числом подозрительных транзакций",
      "description": "Кого из мерчантов проверять в первую очередь",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fraud-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fraud-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT merch AS \"мерчант\", min(cat_id) AS \"категория\", count(*) AS \"транзакций\", sum(fraud_flag) AS \"помечено как фрод\", avg(fraud_flag)::float AS \"доля фрода\", COALESCE(sum(amount) FILTER (WHERE fraud_flag = 1), 0) AS \"сумма помеченных\" FROM scores WHERE $__timeFilter(created_at) AND ('__all' IN ($us_state) OR us_state IN ($us_state)) AND ('__all' IN ($merch) OR merch IN ($merch)) GROUP BY merch HAVING sum(fraud_flag) > 0 ORDER BY 4 DESC, 6 DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
