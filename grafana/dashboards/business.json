    {
      "type": "barchart",
      "id": 5,
      "title": "Плотность распределения скоров",
      "description": "20 корзин по 0.05, высота — доля транзакций в корзине, делённая на ширину корзины. Ось логарифмическая: почти все скоры у нуля",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fraud-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fraud-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH picked AS ( SELECT score FROM scores WHERE $__timeFilter(created_at) AND ('__all' IN ($us_state) OR us_state IN ($us_state)) AND ('__all' IN ($merch) OR merch IN ($merch)) ), bins AS ( SELECT LEAST(width_bucket(score, 0, 1, 20), 20) AS bin, count(*) AS n FROM picked GROUP BY 1 ) SELECT ((g.bin - 1) * 0.05)::text || '–' || (g.bin * 0.05)::text AS \"скор\", COALESCE(bins.n, 0)::float / NULLIF((SELECT count(*) FROM picked), 0) / 0.05 AS \"плотность\" FROM generate_series(1, 20) AS g(bin) LEFT JOIN bins ON bins.bin = g.bin ORDER BY g.bin"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "axisSoftMin": 0,
